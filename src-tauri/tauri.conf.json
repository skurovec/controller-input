{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Controller Input",
    "version": "0.1.0",
    "identifier": "cz.skurovec.controller-input",
    "build": {
        "frontendDist": "../src"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Controller Input",
                "width": 600,
                "height": 500,
                "resizable": true,
                "fullscreen": false,
                "minWidth": 400,
                "minHeight": 400
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "resources": {
            "../LICENSE": "LICENSE",
            "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
